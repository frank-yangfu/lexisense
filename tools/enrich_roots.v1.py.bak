# -*- coding: utf-8 -*-
"""生成词根关联（rt）与词根网络分组（roots）。

优先级：既有 DB.roots 网络 > 词根聚类（前缀?+词根+后缀? 完全可拆）> 复合词 > 前缀 > 后缀
产出：%TEMP%/rt_map.json、%TEMP%/roots_extra.json
"""
import io
import json
import os
import re

TMP = os.path.join(os.path.expanduser('~'), 'AppData', 'Local', 'Temp')
ROOT_DIR = r'D:\我的作品\英语单词速记'

PREFIX = [
    ('anti', '反对'), ('auto', '自己'), ('bi', '二'), ('co', '共同'), ('com', '共同'), ('con', '共同'),
    ('counter', '反对'), ('de', '向下/去除'), ('dis', '否定/分离'), ('en', '使…'), ('ex', '向外'),
    ('extra', '超出'), ('fore', '预先'), ('hyper', '过度'), ('im', '否定/向内'), ('in', '否定/向内'),
    ('inter', '之间'), ('ir', '否定'), ('macro', '宏大'), ('mal', '坏'), ('micro', '微小'), ('mid', '中间'),
    ('mini', '小'), ('mis', '错误'), ('mono', '单一'), ('multi', '多'), ('non', '非'), ('out', '超出'),
    ('over', '过度'), ('poly', '多'), ('post', '之后'), ('pre', '之前'), ('pro', '向前/支持'),
    ('re', '再/回'), ('semi', '半'), ('sub', '下'), ('super', '超'), ('sur', '超过'), ('tele', '远'),
    ('trans', '跨越'), ('tri', '三'), ('ultra', '极端'), ('un', '否定'), ('under', '不足/下'),
    ('uni', '单一'), ('mis', '错误'),
]

SUFFIX = [
    ('able', '可…的'), ('ible', '可…的'), ('al', '…的'), ('ial', '…的'), ('ical', '…的'),
    ('ance', '…状态'), ('ence', '…状态'), ('ancy', '…状态'), ('ency', '…状态'),
    ('ant', '…的人/物'), ('ent', '…的/人'), ('ary', '…的'), ('ory', '…的'),
    ('ate', '使…'), ('ify', '使…'), ('fy', '使…'), ('ize', '使…化'), ('ise', '使…化'),
    ('dom', '…领域'), ('ee', '被…的人'), ('er', '…的人/物'), ('or', '…的人/物'),
    ('ful', '充满…的'), ('hood', '…身份'), ('ship', '…关系/身份'), ('ism', '…主义'), ('ist', '…者'),
    ('ic', '…的'), ('ion', '…过程/状态'), ('tion', '…过程'), ('sion', '…过程'),
    ('ation', '…过程'), ('ition', '…过程'), ('ish', '略…的'), ('ity', '…性质'), ('ty', '…性质'),
    ('ive', '有…性质的'), ('less', '无…的'), ('ly', '…地'), ('ment', '…行为/结果'),
    ('ness', '…性质'), ('ous', '多…的'), ('ious', '多…的'), ('eous', '多…的'),
    ('ure', '…行为/结果'), ('ward', '朝…方向'), ('age', '…行为/总称'), ('ance', '…状态'),
    ('itude', '…状态'), ('acy', '…性质'), ('cy', '…性质'), ('ery', '…的行为/场所'),
    ('ance', '…状态'), ('ate', '使…'), ('ee', '被…的人'), ('est', '最…的'),
    ('ed', '过去/被动'), ('d', '过去/被动'), ('s', '复数/三单'), ('es', '复数/三单'),
    ('en', '使…/由…制成'), ('ar', '…的'), ('id', '…的'), ('ile', '易…的'), ('ine', '…的'),
]
# 屈折后缀（只用于「词根聚类」的可拆性判定，不参与构词拆解展示）
INFL = ('ed', 'd', 's', 'es', 'ing', 'est')
INFL_MEAN = {'ed': '过去/被动', 'd': '过去/被动', 's': '复数/三单', 'es': '复数/三单',
             'ing': '进行', 'est': '最…的'}
SUF_SET = set(s for s, _ in SUFFIX)
SUF_MAP2 = {}
for s, m in SUFFIX:
    SUF_MAP2.setdefault(s, m)
# 复合后缀（如 -ation = -ate + -ion）
COMPOSED = {}
for a in ('ate', 'ite', 'ise', 'ize', 'ite'):
    for b in ('ion', 'ial', 'ive'):
        COMPOSED[a + b] = SUF_MAP2.get(a, '') + '+' + SUF_MAP2.get(b, '')


ROOTS = [
    ('act', '做，行动'), ('aud', '听'), ('bio', '生命'), ('cap', '拿，抓'), ('cede', '走，让'),
    ('ceive', '取'), ('cept', '取'), ('cern', '分辨'), ('cide', '切，落'), ('cis', '切'), ('cid', '切，落'), ('claim', '喊'),
    ('clar', '清楚'), ('clude', '关闭'), ('cogn', '知道'), ('corp', '身体'), ('cred', '相信'),
    ('cult', '耕作'), ('dict', '说'), ('duce', '引导'), ('dur', '持久'), ('equ', '相等'),
    ('fac', '做'), ('fer', '带来'), ('fid', '信任'), ('flect', '弯曲'), ('flu', '流'),
    ('form', '形状'), ('fort', '强'), ('fract', '打破'), ('frag', '破碎'), ('gen', '产生'),
    ('geo', '地球'), ('grade', '步，级'), ('graph', '写'), ('gress', '走'), ('habit', '拥有'),
    ('ject', '投掷'), ('jud', '判断'), ('junct', '连接'), ('lect', '选择，读'), ('lev', '举起'),
    ('loc', '地方'), ('log', '言语，学科'), ('lum', '光'), ('magn', '大'), ('manu', '手'),
    ('mand', '命令'), ('memor', '记忆'), ('meter', '测量'), ('migr', '迁移'), ('miss', '送'),
    ('mit', '送'), ('mob', '移动'), ('mot', '移动'), ('mut', '改变'), ('nat', '出生'),
    ('nom', '名字，法则'), ('nov', '新'), ('oper', '工作'), ('part', '部分'), ('pass', '通过'),
    ('path', '感受，疾病'), ('ped', '脚'), ('pel', '推'), ('pend', '悬挂'), ('pens', '称重'),
    ('phon', '声音'), ('plic', '折叠'), ('pon', '放置'), ('port', '携带'), ('pos', '放置'),
    ('prehend', '抓住'), ('prim', '第一'), ('priv', '私人'), ('prob', '证明'), ('quir', '寻求'),
    ('reg', '统治，规则'), ('rupt', '破裂'), ('sci', '知道'), ('scrib', '写'), ('script', '写'),
    ('sect', '切'), ('sequ', '跟随'), ('serv', '服务，保持'), ('sign', '记号'), ('sist', '站立'),
    ('soci', '社会'), ('sol', '单独'), ('solu', '解开'), ('spect', '看'), ('spir', '呼吸'),
    ('sta', '站立'), ('struct', '建造'), ('tact', '接触'), ('tain', '持有'), ('tect', '覆盖'),
    ('tend', '伸展'), ('tens', '拉紧'), ('term', '界限'), ('terr', '土地'), ('test', '证明'),
    ('text', '编织'), ('tract', '拉'), ('trib', '给予'), ('trud', '推'), ('turb', '搅动'),
    ('vac', '空'), ('val', '价值，强壮'), ('vent', '来'), ('ver', '真实'), ('vers', '转'),
    ('vert', '转'), ('vid', '看'), ('vis', '看'), ('viv', '活'), ('voc', '叫'),
    ('volve', '滚，转'),
]

PREF_MAP = {}
for p, m in PREFIX:
    PREF_MAP.setdefault(p, m)
SUF_MAP = {}
for s, m in SUFFIX:
    SUF_MAP.setdefault(s, m)


def load_words():
    """从 inventory.json 取全库词"""
    inv = json.load(io.open(os.path.join(TMP, 'inventory.json'), encoding='utf-8'))
    return [it['w'] for it in inv]


def load_existing_roots():
    """既有词根网络（由 dump_inventory.js 导出）：{word: (root, mean)}"""
    p = os.path.join(TMP, 'roots_base.json')
    if not os.path.exists(p):
        return {}
    out = {}
    for g in json.load(io.open(p, encoding='utf-8')):
        for x in g['words']:
            out[x['w'].lower()] = (g['root'], g['mean'].split(' ')[0])
    return out


def suf_ok(suf):
    return suf == '' or suf in SUF_SET or suf in COMPOSED or suf in INFL


def try_roots(word):
    """词根聚类：前缀? + 词根 + 后缀? 完全可拆"""
    best = None
    for root, mean in ROOTS:
        p = word.find(root)
        while p >= 0:
            pre, suf = word[:p], word[p + len(root):]
            ok_pre = (pre == '') or (pre in PREF_MAP)
            if ok_pre and suf_ok(suf) and (pre or suf):
                score = len(root) * 10 + len(pre) + len(suf)
                if best is None or score > best[0]:
                    best = (score, root, mean, pre, suf)
            p = word.find(root, p + 1)
    return best


def try_compound(word, wset):
    best = None
    for i in range(3, len(word) - 2):
        a, b = word[:i], word[i:]
        if len(a) < 3 or len(b) < 3 or max(len(a), len(b)) < 4:
            continue
        if a in wset and b in wset:
            score = min(len(a), len(b))
            if best is None or score > best[0]:
                best = (score, a, b)
    return best


def main():
    words = load_words()
    wset = set(words)
    existing = load_existing_roots()

    rt = {}
    stat = {'network': 0, 'root': 0, 'cmp': 0, 'pre': 0, 'suf': 0}
    groups = {}

    # 1) 既有词根网络（最高优先）
    for w in words:
        if w in existing:
            r, m = existing[w]
            rt[w] = {'k': 'net', 'r': r, 'm': '%s（%s）家族' % (r, m)}
            stat['network'] += 1

    # 2) 词根聚类
    for w in words:
        if w in rt or len(w) < 4:
            continue
        b = try_roots(w)
        if not b:
            continue
        _, root, mean, pre, suf = b
        parts = []
        if pre:
            parts.append('%s-（%s）' % (pre, PREF_MAP[pre]))
        parts.append('%s（%s）' % (root, mean))
        if suf:
            parts.append('-%s（%s）' % (suf, SUF_MAP.get(suf, INFL_MEAN.get(suf, '变形'))))
        rt[w] = {'k': 'root', 'r': root, 'm': ' + '.join(parts) + ' → ' + w}
        stat['root'] += 1
        groups.setdefault(root, {'mean': mean, 'words': []})
        groups[root]['words'].append({'w': w, 'm': mean})

    # 3) 复合词
    for w in words:
        if w in rt or len(w) < 8:
            continue
        b = try_compound(w, wset)
        if b:
            _, a, c = b
            rt[w] = {'k': 'cmp', 'r': a + '+' + c, 'm': '%s + %s 复合 → %s' % (a, c, w)}
            stat['cmp'] += 1

    # 4) 前缀
    for w in sorted(words):
        if w in rt or len(w) < 5:
            continue
        for p, pm in PREFIX:
            if w.startswith(p) and len(w) - len(p) >= 4:
                rest = w[len(p):]
                if rest in wset or try_roots(rest):
                    rt[w] = {'k': 'pre', 'r': p, 'm': '%s-（%s）+ %s → %s' % (p, pm, rest, w)}
                    stat['pre'] += 1
                    break

    # 5) 后缀
    all_suf = list(SUFFIX) + [(s, m) for s, m in COMPOSED.items()]
    all_suf.sort(key=lambda x: -len(x[0]))
    for w in sorted(words):
        if w in rt or len(w) < 6:
            continue
        for s, sm in all_suf:
            if w.endswith(s) and len(w) - len(s) >= 4:
                stem = w[:-len(s)]
                cands = [stem, stem + 'e', stem + 'y', stem[:-1] + 'i' if stem else '',
                         stem + stem[-1] if stem else '']
                hit = [c for c in cands if c and c != w and (c in wset or try_roots(c))]
                if hit:
                    rt[w] = {'k': 'suf', 'r': s, 'm': '%s + -%s（%s）→ %s' % (hit[0], s, sm, w)}
                    stat['suf'] += 1
                    break

    # 词根网络：只保留成员 >= 4 且尚未在既有网络里的分组
    net_roots = set(r for r, _ in existing.values())
    extra = []
    for root, g in sorted(groups.items(), key=lambda kv: -len(kv[1]['words'])):
        if len(g['words']) >= 4 and root not in net_roots:
            extra.append({'root': root, 'mean': g['mean'], 'words': g['words']})

    io.open(os.path.join(TMP, 'rt_map.json'), 'w', encoding='utf-8').write(
        json.dumps(rt, ensure_ascii=False, separators=(',', ':')))
    io.open(os.path.join(TMP, 'roots_extra.json'), 'w', encoding='utf-8').write(
        json.dumps(extra, ensure_ascii=False, separators=(',', ':')))

    covered = len(rt)
    print('总词 %d | 词根关联覆盖 %d (%.1f%%) | 网络 %d / 词根 %d / 复合 %d / 前缀 %d / 后缀 %d'
          % (len(words), covered, 100.0 * covered / max(1, len(words)),
             stat['network'], stat['root'], stat['cmp'], stat['pre'], stat['suf']))
    print('新增词根网络分组 %d 组 / %d 词' % (len(extra), sum(len(g['words']) for g in extra)))
    for g in extra[:12]:
        print('  ', g['root'], '(%s)' % g['mean'], ' '.join(x['w'] for x in g['words'][:8]))


if __name__ == '__main__':
    main()
